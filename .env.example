# Copy to .env.local and fill in. Never commit .env.local.

# --- AI (any OpenAI-compatible provider) ---
# Default: NVIDIA (free credits, https://build.nvidia.com → "Get API Key")
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_API_KEY=
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                      LLM_MODEL=llama-3.3-70b-versatile
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                        LLM_MODEL=<a model with tool support>

# --- Coordinator dashboard (required) ---
DASHBOARD_PASSWORD=
# Optional: separate secret for signing session cookies (defaults to the password)
DASHBOARD_SECRET=

# --- Database (optional; in-memory demo store if empty) ---
# Any PostgreSQL, e.g. Neon free tier. Run db/0001_init.sql once.
DATABASE_URL=

# --- WhatsApp Business Cloud API (optional) ---
# Webhook URL to enter in Meta: https://<your-domain>/api/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Telegram alerts for coordinators (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of this app, used in alert links
APP_URL=http://localhost:3000
