# Copy to .env.local and fill in. Never commit .env.local.

# Required: Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required for the coordinator dashboard
DASHBOARD_PASSWORD=
# Optional: separate secret for signing session cookies (defaults to the password)
DASHBOARD_SECRET=

# Optional: persist data in Supabase (otherwise an in-memory demo store is used).
# Run supabase/migrations/0001_init.sql first. Server-side only — never expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Telegram alerts for new contacts, hot leads and handoffs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of this app, used in alert links
APP_URL=http://localhost:3000
